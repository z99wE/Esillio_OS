# Esillio OS Environment Variables

# Authentication
# Generate a new one using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7
ENABLE_GUEST_LOGIN=false

# App Config
DATABASE_URL=sqlite:///./data/esillio.db
FREE_DAILY_CREDITS=5
PAID_DAILY_CREDITS=20
MAX_UPLOAD_MB=10

# AI Configuration (OpenAI, Anthropic, etc.)
# Provide key pools or admin keys here
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase details (Phase 2 Migration)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
